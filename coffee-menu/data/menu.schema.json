{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Меню кофейни (шаблон master_coffe.json)",
  "description": "Если данных нет — пишите null: на сайте такой блок не показывается.",
  "type": "object",
  "properties": {
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id":    { "type": "string", "description": "coffee, tea, cocoa, cold_drinks, pastry, desserts, breakfast, snacks, hot_meals, combo — цвета и рекомендации берутся из data/categories.json" },
          "name":  { "type": "string" },
          "icon":  { "type": ["string", "null"], "description": "Эмодзи раздела; показывается, пока у позиции нет фото" },
          "order": { "type": ["number", "null"], "description": "Порядок в ленте разделов" }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category_id", "name", "variants"],
        "properties": {
          "id":            { "type": "string", "description": "Постоянный идентификатор позиции" },
          "category_id":   { "type": "string" },
          "name":          { "type": "string" },
          "image_url":     { "type": ["string", "null"], "description": "Путь к фото, например pictures/items/master_coffe/item_latte.jpg. Пока файла нет — показывается иконка раздела" },
          "description":   { "type": ["string", "null"] },
          "ingredients":   { "type": ["array", "null"], "items": { "type": "string" } },
          "prep_time_min": { "type": ["number", "null"], "description": "Время приготовления, мин" },
          "is_special":    { "type": "boolean", "description": "true — позиция в блоке «Сегодня в меню»" },
          "variants": {
            "type": "array",
            "minItems": 1,
            "description": "Варианты (объём/вес) со своей ценой. Если вариантов больше одного — на сайте появляется выбор",
            "items": {
              "type": "object",
              "required": ["price"],
              "properties": {
                "variant_id": { "type": "string" },
                "measure":    { "type": ["string", "null"], "description": "Например: 300 мл, 150 г" },
                "price":      { "type": "number" },
                "nutrition": {
                  "type": ["object", "null"],
                  "properties": {
                    "calories": { "type": ["number", "null"] },
                    "proteins": { "type": ["number", "null"] },
                    "fats":     { "type": ["number", "null"] },
                    "carbs":    { "type": ["number", "null"] }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
